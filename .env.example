## ──────────────────────────────────────────────────────────────────────────
## Naqi Tech CRM backend — environment configuration
##
## Copy this file to `.env` and fill in real values. Every value below is a
## placeholder or a safe default — NONE of them are real credentials.
##
## IMPORTANT: several real secrets were, until recently, hardcoded as fallback
## defaults directly inside config/services.php and config/tabby.php (Tabby,
## Tamara, ClickPay, DY365, Taqnyat, PowerBI and Telegram). Those defaults have
## been removed; every one of those integrations will now FAIL LOUDLY instead
## of silently using a stale key if its variable below is left empty. If you
## are setting this up for the first time, get the real values from each
## provider's dashboard and rotate every one of the keys that used to be
## hardcoded — they must be treated as already compromised.
## ──────────────────────────────────────────────────────────────────────────


## ─── Application ────────────────────────────────────────────────────────
APP_NAME=Naqi
# local | staging | production — code checks this exact string in places
# (e.g. the Tamara webhook registration refuses "*" wildcard allowlists
# outside production).
APP_ENV=local
# Generate with: php artisan key:generate
APP_KEY=
APP_DEBUG=false
# Must be the real public https URL of this environment. Several features
# build callback/webhook URLs from this (Tabby, Tamara, ClickPay, DY365
# redirects) — it is never guessed or hardcoded elsewhere.
APP_URL=http://localhost
ASSET_URL=
# Cost factor for password hashing; higher is slower but more secure.
BCRYPT_ROUNDS=12


## ─── Logging ────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Only used if LOG_CHANNEL / a channel stack routes to Slack or a syslog target.
LOG_SLACK_WEBHOOK_URL=
# Used if a log channel is configured to also notify Telegram (see TELEGRAM_*
# below — same bot/chat is typically reused for log alerts and other notices).
LOG_TELEGRAM_LEVEL=error


## ─── Database ───────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=naqi
DB_USERNAME=
DB_PASSWORD=
# DB_SOCKET=
# DB_FOREIGN_KEYS=true
# Only relevant if DB_CONNECTION=sqlsrv (SQL Server):
# DB_ENCRYPT=yes
# DB_TRUST_SERVER_CERTIFICATE=false
# DB_SSL_CA=


## ─── Cache / Session / Queue ────────────────────────────────────────────
BROADCAST_DRIVER=null
CACHE_DRIVER=file
CACHE_PREFIX=
QUEUE_CONNECTION=sync
QUEUE_FAILED_DRIVER=database-uuids
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=


## ─── Redis (only if CACHE_DRIVER / QUEUE_CONNECTION / SESSION_DRIVER = redis) ─
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE=default


## ─── Memcached (only if CACHE_DRIVER=memcached) ─────────────────────────
MEMCACHED_HOST=127.0.0.1
MEMCACHED_PORT=11211


## ─── SQS (only if QUEUE_CONNECTION=sqs) ─────────────────────────────────
SQS_QUEUE=default
SQS_PREFIX=
SQS_SUFFIX=


## ─── Mail ────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@naqi.sa"
MAIL_FROM_NAME="${APP_NAME}"
# Only needed if MAIL_MAILER=mailgun / ses / postmark respectively:
MAILGUN_DOMAIN=
MAILGUN_SECRET=
POSTMARK_TOKEN=


## ─── AWS / S3 (file storage; only if FILESYSTEM_DISK=s3, or user/task images) ─
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false
CLOUDFRONT_URL=


## ─── Broadcasting: Pusher / Ably (only if BROADCAST_DRIVER=pusher/ably) ─────
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
ABLY_KEY=


## ─── Sanctum (API token auth) ───────────────────────────────────────────
# Comma-separated hosts allowed to authenticate via cookie (SPA); leave blank
# for pure token (Bearer) auth, which is what the mobile apps use.
SANCTUM_STATEFUL_DOMAINS=
SANCTUM_TOKEN_PREFIX=


## ─── Tabby (BNPL) ───────────────────────────────────────────────────────
# From the Tabby Merchant Portal (Developers section) — use the LIVE keys in
# production, TEST keys everywhere else. A key from the wrong environment
# authenticates fine but cannot see the other environment's payments, which
# looks exactly like "payment not found" (this caused a real incident).
TABBY_SECRET_KEY=
TABBY_PUBLIC_KEY=
TABBY_MERCHANT_CODE=Naqiappsau
TABBY_BASE_URL=https://api.tabby.ai/api/v2/
# The shared secret Tabby signs webhook deliveries with (Tabby portal ->
# Webhooks). Must be rotated — the previous value was committed to source
# control.
TABBY_WEBHOOK_SECRET=
TABBY_WEBHOOK_HEADER=X-Tabby-Webhook-Secret
# false (default): the browser return marks the payment paid without asking
# Tabby again; the webhook job (ProcessTabbyWebhook) captures/corrects it
# asynchronously. true: ask Tabby to confirm before marking paid on return.
TABBY_VERIFY_SUCCESS_RETURN=false


## ─── Tamara (BNPL) ──────────────────────────────────────────────────────
# From the Tamara Partners portal. Sandbox and production use separate API
# keys and hosts — do not mix them.
TAMARA_API_URL=https://api-sandbox.tamara.co
TAMARA_API_KEY=
# Optional: if set, an incoming Tamara JWT signed with this counts as an
# "authenticated" webhook notification. Processing never depends on it —
# Tamara's API is always asked before a payment changes — so this can be
# left blank.
TAMARA_NOTIFICATION_TOKEN=
TAMARA_HTTP_TIMEOUT=20
TAMARA_HTTP_CONNECT_TIMEOUT=5
# Events to subscribe to when running `php artisan tamara:webhook:register`.
# Tamara rejects unknown event names at registration time (it rejected
# order_updated) — see TAMARA_WEBHOOK_SETUP.md if registration fails.
TAMARA_WEBHOOK_EVENTS=order_approved,order_authorised,order_canceled,order_captured,order_refunded
# Extra hosts the registered webhook URL may be updated to via the API.
# Default (blank): only this app's own host (from APP_URL).
TAMARA_WEBHOOK_ALLOWED_HOSTS=


## ─── ClickPay ───────────────────────────────────────────────────────────
CLICKPAY_BASE_URL=https://secure.clickpay.com.sa
# ClickPay Merchant Dashboard -> Profile -> Server Key. Must be rotated —
# the previous value was committed to source control.
CLICKPAY_SERVER_KEY=
CLICKPAY_PROFILE_ID=
# The public URL ClickPay redirects/calls back to — normally the same as APP_URL.
CLICKPAY_PUBLIC_URL=${APP_URL}


## ─── Dynamics 365 (DY365) ───────────────────────────────────────────────
# Azure AD app registration for the DY365 integration. Must be rotated —
# the previous values were committed to source control.
DY_CLIENT_ID=
DY_CLIENT_SECRET=


## ─── Taqnyat (SMS / OTP delivery) ───────────────────────────────────────
# Must be rotated — the previous value was committed to source control.
TAQNYAT_SMS_API_KEY=
TAQNYAT_SMS_SENDER_TECH=Naqi-Tech
TAQNYAT_SMS_SENDER_CARE=Naqi-Care


## ─── WhatsApp Business API ──────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=


## ─── Firebase / FCM (push notifications) ────────────────────────────────
# Path to the Firebase service-account JSON, or leave unset to use the
# default storage/app/firebase/firebase_cred.json.
FIREBASE_CREDENTIALS=
FIREBASE_PROJECT_ID=naqi-tech
FCM_SERVER_KEY=


## ─── Power BI ───────────────────────────────────────────────────────────
# Must be rotated — the previous values (including a very weak password)
# were committed to source control.
POWERBI_USERNAME=
POWERBI_PASSWORD=


## ─── Telegram (operational alerts/logging) ──────────────────────────────
# From @BotFather. Must be rotated/regenerated — the previous bot token was
# hardcoded directly in config/services.php (not even via an env var).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


## ─── PDF generation (invoices) ──────────────────────────────────────────
# Only needed if the default system Chrome/Node paths are wrong for this host.
CHROME_PATH=/usr/bin/google-chrome-stable
LARAVEL_PDF_NODE_BINARY=
LARAVEL_PDF_NPM_BINARY=
LARAVEL_PDF_CHROME_PATH=
LARAVEL_PDF_NODE_MODULES_PATH=


## ─── Misc / internal APIs ───────────────────────────────────────────────
# Shared key for the data-export endpoint(s).
EXPORT_API_KEY=


## ─── Advanced / rarely needed ───────────────────────────────────────────
## Only relevant if you switch to the driver or feature named — leave unset
## otherwise, the application works fully without any of these.
#
# A single connection-string form of the DB_* settings above, if your host
# provides one instead of discrete DB_HOST/DB_PORT/etc (some PaaS providers do).
# DATABASE_URL=
#
# Only if CACHE_DRIVER=dynamodb:
# DYNAMODB_CACHE_TABLE=cache
# DYNAMODB_ENDPOINT=
#
# Only if LOG_CHANNEL (or a channel in the stack) = papertrail:
# PAPERTRAIL_URL=
# PAPERTRAIL_PORT=
# LOG_PAPERTRAIL_HANDLER=
#
# Only if running under a platform that wants Laravel's stderr logs in a
# particular format (e.g. some container platforms):
# LOG_STDERR_FORMATTER=
#
# Only if CACHE_DRIVER/SESSION_DRIVER/QUEUE_CONNECTION = memcached and that
# server needs auth, or you run a persistent memcached pool:
# MEMCACHED_USERNAME=
# MEMCACHED_PASSWORD=
# MEMCACHED_PERSISTENT_ID=
#
# Only if you use a Redis cluster, a prefix, a full connection URL, or ACL
# username (Redis 6+) instead of the plain REDIS_HOST/PORT/PASSWORD above:
# REDIS_CLUSTER=redis
# REDIS_PREFIX=
# REDIS_URL=
# REDIS_USERNAME=
#
# Only if PUSHER_HOST/PORT/SCHEME need to point somewhere other than
# Pusher's own hosted service (e.g. a self-hosted Pusher-compatible server):
# PUSHER_HOST=
# PUSHER_PORT=443
# PUSHER_SCHEME=https
#
# Only if SESSION_DRIVER=database with a non-default connection/table name:
# SESSION_CONNECTION=
# SESSION_STORE=
#
# Only if MAIL_MAILER needs these less-common options:
# MAIL_URL=
# MAIL_EHLO_DOMAIN=
# MAIL_LOG_CHANNEL=
# MAIL_SENDMAIL_PATH="/usr/sbin/sendmail -bs -i"
# MAILGUN_ENDPOINT=api.mailgun.net
#
# Only if the AWS S3-compatible endpoint is not AWS itself (e.g. MinIO,
# DigitalOcean Spaces):
# AWS_ENDPOINT=
#
# Only if the default system paths for PDF generation (invoices) are wrong
# for this host and CHROME_PATH / LARAVEL_PDF_CHROME_PATH above aren't enough:
# LARAVEL_PDF_BIN_PATH=
# LARAVEL_PDF_INCLUDE_PATH=
# LARAVEL_PDF_TEMP_PATH=
# LARAVEL_PDF_NO_SANDBOX=false
# LARAVEL_PDF_WRITE_OPTIONS_TO_FILE=false
